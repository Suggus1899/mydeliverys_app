# MyDeliveryS App - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# Database (PostgreSQL + PostGIS via PgBouncer)
# =============================================================================
POSTGRES_PASSWORD=changeme
POSTGRES_USER=mydeliverys
POSTGRES_DB=mydeliverys
DATABASE_URL=postgresql+asyncpg://mydeliverys:${POSTGRES_PASSWORD}@localhost:6432/mydeliverys
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=25

# =============================================================================
# Redis: controles sin eviction y cache reconstruible separados
# =============================================================================
REDIS_CONTROL_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Security / JWT
# =============================================================================
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
CREDENTIAL_ENCRYPTION_SECRET=another-secret-minimum-32-characters-long

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
WEB_SESSION_MAX_HOURS=8
PASSWORD_HASH_ALGORITHM=argon2id

# =============================================================================
# OTP / WhatsApp (Meta Cloud API)
# =============================================================================
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_MINUTES=10
OTP_IP_MAX_REQUESTS=5
OTP_IP_WINDOW_MINUTES=3

# Get from Meta Developer Console
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# =============================================================================
# Exchange Rate (DolarAPI Venezuela)
# =============================================================================
DOLARAPI_URL=https://ve.dolarapi.com/v1/dolares/oficial
EXCHANGE_RATE_FETCH_INTERVAL_MINUTES=30
EXCHANGE_RATE_STALE_HOURS=6

# =============================================================================
# Inventory / Reservations
# =============================================================================
RESERVATION_TTL_MINUTES=15

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost,https://your-domain.com

# =============================================================================
# FCM / Push Notifications
# =============================================================================
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG

# =============================================================================
# Flower (Celery Monitoring)
# =============================================================================
FLOWER_PASSWORD=changeme
